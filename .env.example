# ---- Claude (required for any analysis) ----
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model + effort. Opus 5 is the default; drop effort to "medium" or "low" to cut cost.
ATELIER_MODEL=claude-opus-5
ATELIER_EFFORT=high

# ---- Pinterest (optional: only needed for board syncing) ----
# Create an app at https://developers.pinterest.com/apps/
# Set the app's redirect URI to exactly the value below.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8787/api/pinterest/callback

# ---- Shopping ----
# Which retailer set to use for search links: US or UK
ATELIER_REGION=US
# Allow Claude to use live web search to find real, named products with prices.
# Costs extra tokens per lookup. Set to false to get search links only.
ATELIER_WEB_SEARCH=true

# ---- Local paths (defaults are fine) ----
ATELIER_DATA_DIR=./data
